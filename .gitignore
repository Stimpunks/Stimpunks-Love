.DS_Store
node_modules/
*.log

# Claude Code — machine-local settings only.
#
# `.claude/launch.json` IS tracked, the way it is in every sibling repo: how you
# serve the site locally is part of the repo's setup, not something each person
# rediscovers. Same reasoning as netlify.toml being kept here rather than only in
# the dashboard. This file holds whatever one machine has additionally allowed,
# which is nobody else's business and would be noise in a diff.
.claude/settings.local.json

# Local Netlify folder
.netlify

# The Collection Collection: photographs as they arrive, BEFORE
# tools/intake-collection.py has stripped their location and every other byte of
# metadata. Never committed. Empty collection/inbox/taken/ by hand when done.
collection/inbox/

# Rooms people built with their own AI, as they arrive, before
# tools/import-room.py brings them in. The room it writes is the published copy
# and data/rooms/<slug>.json records the artifact's hash, so the file itself is
# not committed. Keep the latest one somewhere: it is what gets imported again.
rooms/inbox/

# The import's own probe files, deleted when it finishes; ignored in case it is
# interrupted mid-render.
.import-*

# A local CB's made-up passwords (CONTRIBUTING.md, Running the CB yourself).
# Never committed, though they open nothing but your own computer.
.env
# Written by Netlify's own tool when it runs the CB on your computer
# (CONTRIBUTING.md, Running the CB yourself). Nothing here uses Deno.
deno.lock
