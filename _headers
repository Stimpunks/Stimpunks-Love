# Netlify custom response headers for stimpunks.love.
#
# Adapted from queering.earth's, which is the house reference. It is shorter here
# because this site is younger and does less: no search index, no per-page fonts
# picker, no accession register. Where a decision is the same, the reasoning there
# is the reasoning here.

/*
  # HTML revalidates every time. There is no build step and no fingerprinting, so
  # a long max-age would strand a reader on a stale page with no way to bust it.
  # NO stale-if-error: RFC 9111 forbids serving a stale must-revalidate response,
  # so the two directives cancel and pairing them is a mistake the spec names.
  Cache-Control: public, max-age=0, must-revalidate

  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

  # THE POLICY BELOW IS GENERATED AND THE HASH IS WHY. It names a sha256 of the
  # inline snippet every page runs before first paint — the one that applies the
  # intensity dial's default. A stale hash does not warn: the browser refuses the
  # snippet and every reader who asked for Gentle is flashed the loud version on
  # the way to the quiet one. That is the precise failure the dial exists to
  # prevent, arriving through the security header. Run tools/make-csp.py after
  # touching that snippet.
  #
  # style-src keeps 'unsafe-inline' because the rooms carry hundreds of inline
  # style attributes, and CSP hashes do not cover style ATTRIBUTES — only <style>
  # elements. The alternative is not a stricter policy, it is deleting the layout.
  #
  # frame-src names youtube-nocookie and nothing else: that is where the jukebox
  # facades put their iframe AFTER a press, and nowhere a page reaches on its own.
  # connect-src is 'none' — no page here fetches anything.
  # >>> csp — generated by tools/make-csp.py; do not hand-edit this line
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; font-src 'self'; connect-src 'none'; frame-src https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-bdYwC+KoYOGM11cVTQZNRVKF6Dw+5AH1qvkgtwqkVV8='
  # <<< csp

  # This site calls no gated device feature of its own. The five delegations exist
  # only so a jukebox facade's player works once a reader has pressed it; they go
  # to the one origin, never to *. Everything else is denied because denying it
  # costs a reader nothing.
  Permissions-Policy: accelerometer=("https://www.youtube-nocookie.com"), autoplay=("https://www.youtube-nocookie.com"), encrypted-media=("https://www.youtube-nocookie.com"), picture-in-picture=("https://www.youtube-nocookie.com"), fullscreen=(self "https://www.youtube-nocookie.com"), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), window-management=(), xr-spatial-tracking=()

  Strict-Transport-Security: max-age=63072000; includeSubDomains

  Link: </llms.txt>; rel="describedby"; type="text/markdown", </feed.xml>; rel="alternate"; type="application/rss+xml"; title="What changed on the street", <https://creativecommons.org/licenses/by-sa/4.0/>; rel="license"

  tdm-reservation: 0

/llms.txt
  Content-Type: text/markdown; charset=UTF-8
  Cache-Control: public, max-age=600, stale-if-error=604800

# The stylesheet and the scripts share the HTML's fate: not fingerprinted, and
# skewable against markup that shipped in the same commit. A reader holding a
# cached love.css against new markup gets an unstyled room, which on a site whose
# rooms ARE the content is a total failure rather than a cosmetic one.
/love.css
  Cache-Control: public, max-age=0, must-revalidate

/love.js
  Cache-Control: public, max-age=0, must-revalidate

/love-embed.js
  Cache-Control: public, max-age=0, must-revalidate

# The faces. A year, and deliberately no `immutable`: these are a specific cut of
# a specific release, but the filename carries no content hash, so promising a
# browser the body can never change is a claim we cannot enforce.
# NO Content-Type here — Netlify types woff2 correctly on its own, and production
# sends nosniff, so an asserted-wrong font type is one the page cannot recover from.
/fonts/*
  Cache-Control: public, max-age=31536000, stale-if-error=2592000
  Access-Control-Allow-Origin: *

/favicon.svg
  Cache-Control: public, max-age=604800, stale-if-error=2592000

# The share cards. Generated by tools/make-og.py from each page's own head, so a
# card changes exactly when the words on the card change -- which is rare, and
# never urgent: a scraper holding last week's card shows an out-of-date preview,
# not a broken page. A week, like the favicon, and no `immutable` for the same
# reason the fonts do not get it: the filename carries no content hash, so we
# cannot promise a body that never changes. Most unfurlers cache these far
# longer than we ask them to anyway, which is the argument for getting the alt
# text right the first time rather than for a short TTL.
/og/*
  Cache-Control: public, max-age=604800, stale-if-error=2592000

# Installability fails silently: a manifest served as text/plain is ignored with
# no console error and no sign on the page.
/site.webmanifest
  Content-Type: application/manifest+json; charset=UTF-8
  Cache-Control: public, max-age=604800, stale-if-error=2592000

# The feed is generated from changelog.html, so it changes exactly when the page
# does. Same short cache as the sitemap: a reader that polls hourly is not worth
# a long TTL, and a stale feed is a changelog that lies by omission.
# Recorded passages. A reading does not change once it is recorded; if one is
# re-recorded it gets a new file rather than a quiet overwrite, so this can be
# cached hard. Nothing here autoplays: the player is preload="none" and makes
# no request until somebody presses it.
/audio/*
  Cache-Control: public, max-age=31536000, stale-if-error=2592000

/feed.xml
  Cache-Control: public, max-age=600, stale-if-error=604800

/sitemap.xml
  Cache-Control: public, max-age=600, stale-if-error=604800

/robots.txt
  Cache-Control: public, max-age=600, stale-if-error=604800
