# Netlify custom response headers for stimpunks.love.
#
# Adapted from queering.earth's, which is the house reference. It is shorter here
# because this site is younger and does less: no search index, no per-page fonts
# picker, no accession register. Where a decision is the same, the reasoning there
# is the reasoning here.

/*
  # HTML revalidates every time. There is no build step and no fingerprinting, so
  # a long max-age would strand a reader on a stale page with no way to bust it.
  # NO stale-if-error: RFC 9111 forbids serving a stale must-revalidate response,
  # so the two directives cancel and pairing them is a mistake the spec names.
  Cache-Control: public, max-age=0, must-revalidate

  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # SAMEORIGIN rather than DENY, and the CSP's frame-ancestors is 'self' to
  # match. The laptop in the Solarpunk Hermitage's cave frames this site inside
  # itself; DENY forbids that, because it has no same-origin exception worth the
  # name. Every other origin is still refused, which is what this header is for.
  X-Frame-Options: SAMEORIGIN

  # THE POLICY BELOW IS GENERATED AND THE HASH IS WHY. It names a sha256 of the
  # inline snippet every page runs before first paint — the one that applies the
  # intensity dial's default. A stale hash does not warn: the browser refuses the
  # snippet and every reader who asked for Gentle is flashed the loud version on
  # the way to the quiet one. That is the precise failure the dial exists to
  # prevent, arriving through the security header. Run tools/make-csp.py after
  # touching that snippet.
  #
  # style-src keeps 'unsafe-inline' because the rooms carry hundreds of inline
  # style attributes, and CSP hashes do not cover style ATTRIBUTES — only <style>
  # elements. The alternative is not a stricter policy, it is deleting the layout.
  #
  # frame-src names youtube-nocookie, where the jukebox facades put their iframe
  # AFTER a press; 'self', which is the laptop in the Hermitage's cave — this site
  # framed inside this site; open.spotify.com, which is Club Chronic's stage; and
  # videopress.com, which is the ten seconds of Ryan's own grass in Swaying
  # Sweetgrass — a video we already publish on stimpunks.org, served from where
  # it already lives rather than copied onto this site.
  # Every one of them only after a press, and none of them anywhere a page goes
  # on its own.
  # DO NOT EDIT THE frame-src LIST BELOW. That whole line is generated by
  # tools/make-csp.py, which reads the origins out of love-embed.js's ORIGINS
  # array — the one place they are written down. A hand edit here looks right,
  # survives review, and is put back by the next run of any tool that calls
  # make-csp.py. That is how videopress.com shipped: added here by hand,
  # reverted silently, working on a dev server that serves no headers at all,
  # and refused on the live site. Add the origin to love-embed.js and re-run.
  # connect-src is 'none' — no page here fetches anything.
  # >>> csp — generated by tools/make-csp.py; do not hand-edit this line
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; frame-src 'self' https://www.youtube-nocookie.com https://open.spotify.com https://videopress.com https://embed.music.apple.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-SaqJKNtS0ce0n2ga1jlqn33viIxAZwFgOg0YlgQub5M='; upgrade-insecure-requests
  # <<< csp

  # This site calls no gated device feature of its own. The five delegations exist
  # only so a jukebox facade's player works once a reader has pressed it; they go
  # to the one origin, never to *. Everything else is denied because denying it
  # costs a reader nothing.
  Permissions-Policy: accelerometer=("https://www.youtube-nocookie.com"), autoplay=("https://www.youtube-nocookie.com"), encrypted-media=("https://www.youtube-nocookie.com"), picture-in-picture=("https://www.youtube-nocookie.com"), fullscreen=(self "https://www.youtube-nocookie.com"), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), window-management=(), xr-spatial-tracking=()

  Strict-Transport-Security: max-age=63072000; includeSubDomains

  # rel="api-catalog" is registered by RFC 9727 and is the one discovery relation
  # here that is. `agent-skills`, `sitemap` and `security` are NOT in the IANA
  # registry -- Star Stuff read it on 2026-09-10 and published a correction for
  # having used two of them -- so none of those three is advertised here; their
  # well-known paths and robots.txt are the discovery.
  Link: </llms.txt>; rel="describedby"; type="text/markdown", </feed.xml>; rel="alternate"; type="application/rss+xml"; title="What changed on the street", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", <https://creativecommons.org/licenses/by-sa/4.0/>; rel="license"

  tdm-reservation: 0

/llms.txt
  Content-Type: text/markdown; charset=UTF-8
  Cache-Control: public, max-age=600, stale-if-error=604800

# The stylesheet and the scripts share the HTML's fate: not fingerprinted, and
# skewable against markup that shipped in the same commit. A reader holding a
# cached love.css against new markup gets an unstyled room, which on a site whose
# rooms ARE the content is a total failure rather than a cosmetic one.
/love.css
  Cache-Control: public, max-age=0, must-revalidate

/love.js
  Cache-Control: public, max-age=0, must-revalidate

/love-embed.js
  Cache-Control: public, max-age=0, must-revalidate

# The faces. A year, and deliberately no `immutable`: these are a specific cut of
# a specific release, but the filename carries no content hash, so promising a
# browser the body can never change is a claim we cannot enforce.
# NO Content-Type here — Netlify types woff2 correctly on its own, and production
# sends nosniff, so an asserted-wrong font type is one the page cannot recover from.
/fonts/*
  Cache-Control: public, max-age=31536000, stale-if-error=2592000
  Access-Control-Allow-Origin: *

/favicon.svg
  Cache-Control: public, max-age=604800, stale-if-error=2592000

# The rendered icons, all pictures of favicon.svg taken by tools/make-icons.py, so
# they change exactly when it does: the same week, for the same reason. Listed one
# by one rather than by pattern so that a new icon is a decision somebody writes
# down here as well as in the tool.
/favicon.ico
  Cache-Control: public, max-age=604800, stale-if-error=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-if-error=2592000
/icon-192.png
  Cache-Control: public, max-age=604800, stale-if-error=2592000
/icon-512.png
  Cache-Control: public, max-age=604800, stale-if-error=2592000
/icon-maskable-512.png
  Cache-Control: public, max-age=604800, stale-if-error=2592000

# The Raven nook: Gustave Dore's 1884 plates and three leaves of the 1865
# Tyndale printing. An engraving published in 1884 does not get revised either,
# so the same hard cache as the deck's.
/raven/*
  Cache-Control: public, max-age=31536000, stale-if-error=2592000

# The oracle deck's engravings. Public domain works from the Metropolitan
# Museum's open collection, downloaded once and committed. A print from 1514
# does not get revised, so this is the one image directory here that can be
# cached hard -- and unlike the community photographs in /photos, nothing in it
# is a picture of a person who might withdraw it.
/oracle/*
  Cache-Control: public, max-age=31536000, stale-if-error=2592000

# The share cards. Generated by tools/make-og.py from each page's own head, so a
# card changes exactly when the words on the card change -- which is rare, and
# never urgent: a scraper holding last week's card shows an out-of-date preview,
# not a broken page. A week, like the favicon, and no `immutable` for the same
# reason the fonts do not get it: the filename carries no content hash, so we
# cannot promise a body that never changes. Most unfurlers cache these far
# longer than we ask them to anyway, which is the argument for getting the alt
# text right the first time rather than for a short TTL.
/og/*
  Cache-Control: public, max-age=604800, stale-if-error=2592000

# Installability fails silently: a manifest served as text/plain is ignored with
# no console error and no sign on the page.
/site.webmanifest
  Content-Type: application/manifest+json; charset=UTF-8
  Cache-Control: public, max-age=604800, stale-if-error=2592000

# The feed is generated from changelog.html, so it changes exactly when the page
# does. Same short cache as the sitemap: a reader that polls hourly is not worth
# a long TTL, and a stale feed is a changelog that lies by omission.
# Recorded passages. A reading does not change once it is recorded; if one is
# re-recorded it gets a new file rather than a quiet overwrite, so this can be
# cached hard. Nothing here autoplays: the player is preload="none" and makes
# no request until somebody presses it.
/audio/*
  Cache-Control: public, max-age=31536000, stale-if-error=2592000

/feed.xml
  Cache-Control: public, max-age=600, stale-if-error=604800

/sitemap.xml
  Cache-Control: public, max-age=600, stale-if-error=604800

/robots.txt
  Cache-Control: public, max-age=600, stale-if-error=604800

# security.txt, RFC 9116, written by tools/make-security.py. text/plain is what the
# RFC requires, stated rather than inferred because a Content-Type is a claim.
# Cached for a day and no stale-if-error: the file carries an Expires date, and a
# proxy serving a copy past its own validity window is the one caching failure that
# matters here. Star Stuff's reasoning. NOT advertised in the Link header: `security`
# is not a registered link relation, and the well-known path is the discovery.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

# The API catalogue (RFC 9727, an RFC 9264 Linkset) and the agent skills index,
# both written by tools/make-agent-files.py. THE CATALOGUE'S CONTENT-TYPE IS
# LOAD-BEARING: the file has no extension, Netlify would serve it as
# application/octet-stream, and an agent that type-checks skips anything that is
# not application/linkset+json. An hour's cache, Star Stuff's reasoning: these are
# the documents an agent most likely fetched before we changed something.
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Cache-Control: public, max-age=3600

# CORS IS OPEN ON THE SKILLS AND NOWHERE ELSE ON THIS SITE EXCEPT THE FONTS. A
# browser-based agent on another origin gets nothing without it, and these are
# the files written to be read cross-origin. They hold no secrets and no visitor
# data, so the risk is the ordinary one a plain GET of the URL already carries.
# Do not copy this block to anything else.
/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# */SKILL.md and not a bare *, which would also match index.json above: Netlify
# combines the headers of every rule a path matches, and the index would be served
# with two content types. Star Stuff's pattern, confirmed live on 2026-09-23.
/.well-known/agent-skills/*/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
